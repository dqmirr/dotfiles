{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo":{
    "type": "small",
    "color": {
      "1":"#5f875f",
      "2":"#5f875f"
    },
    "padding":{
      "left": 2,
      "top": 2,
    },
  },
  "display": {
    "separator": "",
    "color": {
      "separator": "red"
    }
  },
  "modules": [
    {
      "type": "custom", // HardwareStart
      // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐",
    },
    {
      "type": "cpu",
      "key": "{#35}󰍛 cpu      ",
      "temp": true
    },
    {
      "type": "memory",
      "key": "{#32} memory   ",
    },
    {
      "type": "swap",
      "key": "{#36}{icon}swap   ",
    },
    // "disk",
    // "localip",
    // "battery",
    // "poweradapter",
    {
      "type": "custom", // InformationEnd
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    {
      "type": "custom", // Separator
      "format": "",
    },
    {
      "type": "custom", // HardwareStart
      // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐",
    },
    {
      "type": "os",
      "key": "{#33}{icon} distro   ",
    },
    {
      "type": "host",
      "key": "{#34}󰇄 host  ",
    },
    {
      "type": "uptime",
      "key": "{#32}󰅐 uptime   ",
    },
    // "packages",
    {
      "type": "shell",
      "key": "{#36} shell    ",
    },
    // "display",
    // "de",
    // "wm",
    // "wmtheme",
    // "theme",
    // "icons",
    // "font",
    // "cursor",
    // "terminal",
    // "terminalFont",
    // "gpu",
    // "locale",
    {
      "type": "custom", // InformationEnd
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 20,
    },
  ]
}
